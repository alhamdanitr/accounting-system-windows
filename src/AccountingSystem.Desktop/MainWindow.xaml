<Window x:Class="AccountingSystem.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام المحاسبة وإدارة المخزون المؤسسي (Enterprise Desktop ERP) - محل الشبكات والإلكترونيات"
        Height="820" Width="1360"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <!-- تصميم الأزرار الجانبية -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- تصميم الأزرار القياسية للعمليات -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- تصميم الأزرار الثانوية -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#F8FAFC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- القائمة الجانبية المؤسسية (Side Navigation) -->
        <Border Grid.Column="0" Background="#0F172A" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <!-- شعار النظام -->
                    <TextBlock Text="ERP NETWORKING" FontSize="18" FontWeight="ExtraBold" Foreground="#38BDF8" Margin="0,4,0,2"/>
                    <TextBlock Text="نظام إدارة الشبكات والإلكترونيات" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,20"/>

                    <Separator Background="#334155" Margin="0,0,0,16"/>

                    <Button Content="📊 لوحة المؤشرات التنفيذية" Style="{StaticResource SidebarButtonStyle}" Click="NavDashboard_Click" Margin="0,0,0,6"/>
                    <Button Content="🛒 نقطة البيع (POS Terminal)" Style="{StaticResource SidebarButtonStyle}" Click="NavPOS_Click" Margin="0,0,0,6"/>
                    <Button Content="📦 إدارة المخازن والأصناف" Style="{StaticResource SidebarButtonStyle}" Click="NavInventory_Click" Margin="0,0,0,6"/>
                    <Button Content="👥 العملاء والموردين (الذمم)" Style="{StaticResource SidebarButtonStyle}" Click="NavCustomers_Click" Margin="0,0,0,6"/>
                    <Button Content="💰 السندات والقيود اليومية" Style="{StaticResource SidebarButtonStyle}" Click="NavVouchers_Click" Margin="0,0,0,6"/>
                    <Button Content="🔄 التحويلات والمرتجعات" Style="{StaticResource SidebarButtonStyle}" Click="NavTransfers_Click" Margin="0,0,0,6"/>
                    <Button Content="📈 التقارير المالية والضريبية" Style="{StaticResource SidebarButtonStyle}" Click="NavReports_Click" Margin="0,0,0,6"/>
                    <Button Content="⚙️ إعدادات النظام والأجهزة" Style="{StaticResource SidebarButtonStyle}" Click="NavSettings_Click" Margin="0,0,0,6"/>
                </StackPanel>

                <!-- معلومات المستخدم والمزامنة السفلية -->
                <Border DockPanel.Dock="Bottom" Background="#1E293B" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="المستخدم: المدير العام" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="الفرع: المعرض الرئيسي" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,8"/>
                        <Button Content="🔄 مزامنة فورية الآن" Style="{StaticResource PrimaryButtonStyle}" FontSize="11" Padding="8,6" Click="SyncNow_Click"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- منطقة المحتوى الرئيسي (Main Content Area) -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- شريط العنوان العلوي وحالة النظام -->
            <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="PageTitleText" Text="لوحة المؤشرات التنفيذية (Executive Dashboard)" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border Background="#DCFCE7" CornerRadius="6" Padding="10,6" Margin="10,0,0,0">
                            <TextBlock Text="🟢 متصل بالسحابة (Railway Cloud)" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                        </Border>
                        <Border Background="#EFF6FF" CornerRadius="6" Padding="10,6" Margin="6,0,0,0">
                            <TextBlock Text="📦 قاعدة بيانات موحدة" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- محتوى الشاشات الديناميكي مع DataGrids حقيقية ونوافذ تشغيل -->
            <Border Grid.Row="1" x:Name="ContentContainer" Background="#FFFFFF" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                <!-- المحتوى الافتراضي: لوحة التحكم -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="نظرة عامة على أداء معارض ومستودعات الشبكات والإلكترونيات" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBlock Text="تحديث لحظي لعمليات المبيعات، المخزون الحرج، وحركة الذمم المالية." FontSize="13" Foreground="#64748B" Margin="0,0,0,20"/>

                        <!-- شبكة المؤشرات التنفيذية (KPI Cards) -->
                        <UniformGrid Columns="4" Margin="0,0,0,24">
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="إجمالي مبيعات اليوم" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="4,850.00 $" FontSize="24" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,8,0,0"/>
                                    <TextBlock Text="↑ 18% مقارنة بالأمس" FontSize="11" Foreground="#16A34A" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="أصناف منخفضة المخزون" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="3 أصناف" FontSize="24" FontWeight="ExtraBold" Foreground="#DC2626" Margin="0,8,0,0"/>
                                    <TextBlock Text="تحتاج إعادة طلب عاجلة" FontSize="11" Foreground="#DC2626" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="أرصدة العملاء (مديونيات)" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="5,230.00 $" FontSize="24" FontWeight="ExtraBold" Foreground="#7C3AED" Margin="0,8,0,0"/>
                                    <TextBlock Text="الذمم المدينة المستحقة" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="النقدية في الصندوق والبنك" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="32,400.00 $" FontSize="24" FontWeight="ExtraBold" Foreground="#2563EB" Margin="0,8,0,0"/>
                                    <TextBlock Text="السيولة المتاحة للتشغيل" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- قسم العمليات السريعة وجداول العمليات الأخيرة -->
                        <TextBlock Text="آخر الفواتير المسجلة في النظام" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                        <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="220" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNo}" Width="120"/>
                                <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="200"/>
                                <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding DateTime}" Width="160"/>
                                <DataGridTextColumn Header="المبلغ الإجمالي" Binding="{Binding TotalAmount}" Width="130"/>
                                <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="130"/>
                                <DataGridTextColumn Header="حالة الدفع" Binding="{Binding Status}" Width="120"/>
                                <DataGridTextColumn Header="المستخدم المسؤول" Binding="{Binding User}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
