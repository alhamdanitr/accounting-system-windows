<Window x:Class="AccountingSystem.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام المحاسبة وإدارة المخزون المؤسسي (Enterprise Desktop ERP) - محل الشبكات والإلكترونيات"
        Height="768" Width="1280"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">
    
    <Window.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#F1F5F9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- القائمة الجانبية المؤسسية (Side Navigation) -->
        <Border Grid.Column="0" Background="#1E293B" Padding="16">
            <StackPanel>
                <!-- شعار النظام -->
                <TextBlock Text="النظام المحاسبي المؤسسي" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                <TextBlock Text="أجهزة الشبكات والإلكترونيات" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,24"/>
                
                <Separator Background="#334155" Margin="0,0,0,16"/>

                <Button Content="📊 لوحة المؤشرات التنفيذية" Style="{StaticResource SidebarButtonStyle}" Click="NavDashboard_Click" Margin="0,0,0,4"/>
                <Button Content="🛒 نقطة البيع (POS Terminal)" Style="{StaticResource SidebarButtonStyle}" Click="NavPOS_Click" Margin="0,0,0,4"/>
                <Button Content="📦 إدارة المخازن والأصناف" Style="{StaticResource SidebarButtonStyle}" Click="NavInventory_Click" Margin="0,0,0,4"/>
                <Button Content="👥 العملاء والموردين (الذمم)" Style="{StaticResource SidebarButtonStyle}" Click="NavCustomers_Click" Margin="0,0,0,4"/>
                <Button Content="💰 السندات والقيود اليومية" Style="{StaticResource SidebarButtonStyle}" Click="NavVouchers_Click" Margin="0,0,0,4"/>
                <Button Content="🔄 التحويلات والمرتجعات" Style="{StaticResource SidebarButtonStyle}" Click="NavTransfers_Click" Margin="0,0,0,4"/>
                <Button Content="📈 التقارير المالية والضريبية" Style="{StaticResource SidebarButtonStyle}" Click="NavReports_Click" Margin="0,0,0,4"/>
                <Button Content="⚙️ إعدادات النظام والأجهزة" Style="{StaticResource SidebarButtonStyle}" Click="NavSettings_Click" Margin="0,0,0,4"/>
            </StackPanel>
        </Border>

        <!-- منطقة المحتوى الرئيسي (Main Content Area) -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- شريط العنوان العلوي -->
                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <TextBlock x:Name="PageTitleText" Text="لوحة المؤشرات التنفيذية (Executive Dashboard)" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border Background="#DCFCE7" CornerRadius="4" Padding="8,4" Margin="8,0,0,0">
                                <TextBlock Text="🟢 المتصل بالسحابة (Online)" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                            </Border>
                            <TextBlock Text="الفرع الرئيسي: معرض بغداد للشبكات" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

            <!-- محتوى الشاشات الديناميكي (Content Container) -->
            <Border Grid.Row="1" x:Name="ContentContainer" Background="#FFFFFF" CornerRadius="8" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="مرحباً بك في نظام المحاسبة وإدارة المخزون لقطع الشبكات والإلكترونيات." FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBlock Text="قم بتحديد الخيار المطلوب من القائمة الجانبية للبدء بالعمليات (المبيعات، المخزون، السندات، والتقارير)." FontSize="13" Foreground="#64748B" Margin="0,4,0,16"/>

                        <!-- شبكة المؤشرات السريعة -->
                        <UniformGrid Columns="4" Margin="0,0,0,24">
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="إجمالي مبيعات اليوم" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="3,450.00 $" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0"/>
                                    <TextBlock Text="↑ 12% عن الأمس" FontSize="11" Foreground="#16A34A" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="أصناف منخفضة المخزون" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="4 أصناف" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,8,0,0"/>
                                    <TextBlock Text="تحتاج إعادة طلب" FontSize="11" Foreground="#DC2626" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="أرصدة العملاء (مديونيات)" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="4,100.00 $" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" Margin="0,8,0,0"/>
                                    <TextBlock Text="الذمم المدينة المستحقة" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="الأصول النقدية والبنكية" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="24,850.00 $" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,8,0,0"/>
                                    <TextBlock Text="الصندوق والبنك" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
