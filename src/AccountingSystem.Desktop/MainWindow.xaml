<Window x:Class="AccountingSystem.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام المحاسبة وإدارة المخزون" Height="720" Width="1280" FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Side Menu -->
        <Border Grid.Column="0" Background="#2C3E50" Padding="10">
            <StackPanel>
                <TextBlock Text="القائمة الرئيسية" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,30" HorizontalAlignment="Center"/>
                
                <Button x:Name="BtnDashboard" Content="📊 لوحة التحكم" Margin="0,5" Padding="15,10" Background="#34495E" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Click="NavButton_Click"/>
                <Button x:Name="BtnPOS" Content="🛒 نقطة البيع" Margin="0,5" Padding="15,10" Background="#34495E" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Click="NavButton_Click"/>
                <Button x:Name="BtnInventory" Content="📦 إدارة المخزون" Margin="0,5" Padding="15,10" Background="#34495E" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Click="NavButton_Click"/>
                <Button x:Name="BtnAccounting" Content="💰 المحاسبة والمالية" Margin="0,5" Padding="15,10" Background="#34495E" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Click="NavButton_Click"/>
                <Button x:Name="BtnReports" Content="📄 التقارير الشاملة" Margin="0,5" Padding="15,10" Background="#34495E" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Click="NavButton_Click"/>
                
                <Separator Margin="0,20" Background="#7F8C8D"/>
                
                <Button x:Name="BtnSettings" Content="⚙️ الإعدادات" Margin="0,5" Padding="15,10" Background="#34495E" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Click="NavButton_Click"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Column="1" Background="White">
            <Border x:Name="ContentArea" Margin="20" BorderBrush="#ECF0F1" BorderThickness="1" CornerRadius="5">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="مرحباً بك في نظام المحاسبة المتكامل" FontSize="24" FontWeight="SemiBold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                    <TextBlock Text="الرجاء اختيار قسم من القائمة الجانبية للبدء بالعمل" FontSize="16" Foreground="#7F8C8D" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
